{
  "name": "quote-library",
  "version": "1.2.3",
  "description": "A mobile-compatible, Markdown-first quote dashboard for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test:utils": "node scripts/test-utils.mjs",
    "test:portability": "node scripts/validate-portability.mjs",
    "test": "npm run typecheck && npm run build && npm run test:utils && node scripts/validate-build.mjs && npm run test:portability"
  },
  "keywords": ["obsidian", "quotes", "dashboard", "markdown", "mobile"],
  "author": "Corthon",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Red-Beard08/quote-library.git" },
  "homepage": "https://github.com/Red-Beard08/quote-library#readme",
  "bugs": { "url": "https://github.com/Red-Beard08/quote-library/issues" },
  "engines": { "node": ">=18" },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.7.0"
  }
}
