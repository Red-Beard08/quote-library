{
  "compilerOptions": {
    "baseUrl": ".", "typeRoots": ["node_modules/@types", "node_modules/obsidian"],
    "inlineSourceMap": true, "inlineSources": true, "module": "ESNext", "target": "ES6",
    "allowJs": false, "noImplicitAny": true, "strictFunctionTypes": true, "strictNullChecks": true,
    "noImplicitReturns": true, "noImplicitThis": true, "noUnusedLocals": true,
    "moduleResolution": "node", "downlevelIteration": true, "esModuleInterop": true,
    "skipLibCheck": true, "lib": ["DOM", "ES6"]
  },
  "include": ["src/**/*.ts"]
}
